# Build output is committed on purpose: termux-start.sh only compiles when
# dist/index.js is absent, so phones start from the prebuilt tree instead of
# running tsc on device. Ignoring dist/ here did not untrack the 250 files
# already committed — it only stopped new ones from joining them, which left
# the tree permanently drifting from src/.

# Dependencies
node_modules/
.pnpm-store/

# Lockfiles (bun is packageManager)
package-lock.json
pnpm-lock.yaml
yarn.lock

# Editors / OS
.cursor/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Env / local
.env
.env.*
!.env.example
*.log
.cache/

# Research notes (not shipped)
research/
