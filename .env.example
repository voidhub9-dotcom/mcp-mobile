# Copy to .env for local runs, or set these as Railway service variables.

# --- Core ---------------------------------------------------------------
# Required for any public deployment. Also gates /auth/discord linking.
MCP_AUTH_TOKEN=

# --- VoidHub RPC (Discord cloud Rich Presence) --------------------------
# All optional: leave DISCORD_CLIENT_ID empty to disable the feature.
# Discord Developer Portal -> your app -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a Redirect URI added in the Developer Portal exactly.
DISCORD_REDIRECT_URI=https://your-app.up.railway.app/auth/discord/callback
# Rich Presence asset key (uploaded under Rich Presence -> Art Assets) or an https image URL.
DISCORD_LARGE_IMAGE_KEY=void_logo
# The big image is the current Roblox game's icon; this logo becomes the small badge.
# Set DISCORD_SHOW_GAME_ICON=false to always use the logo as the big image.
# DISCORD_SHOW_GAME_ICON=true
# Link for the "Get VoidHub" button (default: the VoidHub Discord). "off" hides it.
# DISCORD_BUTTON_URL=https://discord.gg/4AdJr8emK2
# DISCORD_SHOW_GAME_BUTTON=true  # "See Game Page" button for the current Roblox game
# 32-byte key used to encrypt stored Discord tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Optional tuning
# Where encrypted tokens are stored. Point this at a Railway volume so links survive redeploys.
# DISCORD_TOKEN_STORE_PATH=/data/discord-links.json
# DISCORD_PRESENCE_IDLE_MS=300000       # clear presence after 5 min with no MCP tool calls
# DISCORD_PRESENCE_THROTTLE_MS=15000    # min gap between presence updates (min 15000)
# DISCORD_PRESENCE_KEEPALIVE_MS=120000  # re-send presence this often while active
